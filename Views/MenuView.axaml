<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnakeGame.Views.MenuView">
    <StackPanel Width="360"
                Spacing="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Classes="title" Text="Snake" HorizontalAlignment="Center"/>
        <TextBlock x:Name="HelloText"
                   Classes="muted"
                   HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Play game" Click="OnPlay"/>
        <Button Classes="secondary" Content="Leaderboard" Click="OnLeaderboard"/>
        <Button Classes="secondary" Content="Change user" Click="OnChangeUser"/>
    </StackPanel>
</UserControl>
