<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnakeGame.Views.PlaySetupView">
    <StackPanel Width="420"
                Spacing="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Classes="title" Text="New game" HorizontalAlignment="Center"/>

        <TextBlock Text="Walls" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="SolidMode"
                         GroupName="Mode"
                         Content="Solid walls"
                         IsChecked="True"/>
            <RadioButton x:Name="WrapMode"
                         GroupName="Mode"
                         Content="Wrap around"/>
        </StackPanel>
        <TextBlock Classes="muted"
                   Text="Solid walls: hitting the border ends the run. Wrap: the snake comes out the opposite side."
                   TextWrapping="Wrap"/>

        <TextBlock Text="Difficulty" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton x:Name="EasyDiff" GroupName="Diff" Content="Easy"/>
            <RadioButton x:Name="MediumDiff" GroupName="Diff" Content="Medium" IsChecked="True"/>
            <RadioButton x:Name="HardDiff" GroupName="Diff" Content="Hard"/>
        </StackPanel>
        <TextBlock Classes="muted"
                   Text="Difficulty only changes snake speed. The board stays 20×20."
                   TextWrapping="Wrap"/>

        <Button Classes="primary" Content="Start" Click="OnStart"/>
        <Button Classes="secondary" Content="Back" Click="OnBack"/>
    </StackPanel>
</UserControl>
